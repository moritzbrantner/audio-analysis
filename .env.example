# audio-analysis optional local environment contract.
#
# Ordinary deterministic validation does not require the opt-in model, media,
# or external-tool variables below. Enable only the integrations/tests you
# intend to run. Keep secrets and machine-specific credentials in your local
# .env or shell environment, never in this committed example.

# GitHub Pages browser E2E target. The repository-local runner uses this default.
PAGES_E2E_BASE_URL=http://127.0.0.1:4173

# Opt-in external/native test switches. Keep disabled unless their documented
# caller-owned model/tool/media prerequisites are available.
FFMPEG_EXTERNAL_TESTS=0
RUN_CANDLE_WHISPER_DECODE_TESTS=0
RUN_NATIVE_MEDIA_DECODE_TESTS=0
RUN_NATIVE_WHISPER_TESTS=0
RUN_NATIVE_WHISPER_MODEL_CACHE_TESTS=0
RUN_NATIVE_TRANSCRIPTION_TESTS=0
RUN_NATIVE_TRANSLATION_TESTS=0
RUN_NATIVE_ALIGNMENT_TESTS=0
RUN_NATIVE_SPEAKER_MODEL_TESTS=0
RUN_NATIVE_DIARIZATION_TESTS=0
RUN_REAL_DEMUCS_TESTS=0

# Whisper/Candle/WhisperX caller-owned local model and fixture paths.
CANDLE_WHISPER_TINY_BUNDLE=/path/to/whisper-tiny-bundle
CANDLE_WHISPER_SMALL_BUNDLE=/path/to/whisper-small-bundle
CANDLE_WHISPER_Q8_BUNDLE=/path/to/whisper-q8-bundle
CANDLE_WHISPER_Q8_WAV=/path/to/q8-probe.wav
CANDLE_WHISPER_GERMAN_WAV=/path/to/german-probe.wav
CANDLE_WHISPER_GERMAN_WHISPERX_ORACLE=/path/to/whisperx-oracle.json
CANDLE_WHISPER_GERMAN_MEL_ORACLE=/path/to/mel-oracle.raw
CANDLE_WHISPER_GERMAN_LOGITS_ORACLE=/path/to/logits-oracle.raw
CANDLE_WHISPER_GERMAN_LONG_WAV=/path/to/german-long.wav
CANDLE_WHISPER_GERMAN_LONG_WHISPERX_ORACLE=/path/to/german-long-whisperx-oracle.json
NATIVE_WHISPER_AUDIO_PATH=/path/to/whisper-smoke.wav
WHISPER_CPP_MODEL_STORE=/path/to/whisper.cpp-model-store
TRANSCRIPTION_MEDIA_PATH=/path/to/media-input
TRANSCRIPTION_AUDIO_PATH=/path/to/transcription.wav
TRANSCRIPTION_MODEL_DIR=/path/to/transcription-model-directory
TRANSCRIPTION_MODEL_ID=/path-or-id/to/transcription-model
TRANSCRIPTION_MODEL_BUNDLE=/path/to/transcription-model-bundle
ALIGNMENT_TRANSCRIPT_TEXT=example transcript
NATIVE_WHISPERX_SILERO_ONNX=/path/to/silero-vad.onnx

# Speaker/diarization caller-owned local model and fixture paths.
SPEAKER_EMBEDDING_MODEL_BUNDLE=/path/to/speaker-model-bundle
SPEAKER_EMBEDDING_MODEL_FILE=model.onnx
SPEAKER_EMBEDDING_DIMENSION=192
# Leave ONNX IO names empty unless the selected model requires explicit names.
SPEAKER_EMBEDDING_INPUT_NAME=
SPEAKER_EMBEDDING_OUTPUT_NAME=
DIARIZATION_AUDIO_PATH=/path/to/diarization.wav
PYANNOTE_COMMUNITY_BUNDLE=/path/to/pyannote-community-bundle
PYANNOTE_TWO_SPEAKER_WAV=/path/to/two-speaker.wav
PYANNOTE_TEST_TMPDIR=/tmp/audio-analysis-pyannote
ONNX_RUNTIME_LOAD_MODE=file
ORT_DYLIB_PATH=/path/to/libonnxruntime.so

# TTS caller-owned local bundles and optional model identifiers.
F5_TTS_BUNDLE=/path/to/f5-tts-bundle
VOCOS_BUNDLE=/path/to/vocos-bundle
F5_TTS_MODEL_ID=f5-tts-v1-base
VOCOS_MODEL_ID=/path-or-id/to/vocos-model
# Package-surface smoke tests also exercise these F5 aliases.
F5_BUNDLE=/path/to/f5-bundle
F5_MODEL_ID=f5-tts-v1-base

# External source-separation executable; defaults to `demucs` when unset.
DEMUCS_COMMAND=demucs

# Optional cache/runtime overrides used by local model integrations.
HF_HOME=/path/to/huggingface-cache
VIDEO_ANALYSIS_STUDIO_CACHE_DIR=/path/to/video-analysis-studio-cache
# Host-owned Windows location; keep unset on other platforms unless needed.
LOCALAPPDATA=
CARGO_TARGET_DIR=target
RAYON_NUM_THREADS=4
