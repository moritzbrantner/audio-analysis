{
  "name": "@moritzbrantner/audio-analysis-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "check:structure": "python3 scripts/check_extraction.py",
    "check:fast": "bash scripts/check-fast.sh",
    "check:handoff": "bash scripts/check-handoff.sh",
    "check": "bun run check:handoff"
  }
}
