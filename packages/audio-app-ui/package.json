{
  "name": "@moritzbrantner/audio-app-ui",
  "version": "0.1.0",
  "description": "Private package-surface workbench for audio-analysis apps.",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./package-surface": { "types": "./dist/package-surface/index.d.ts", "import": "./dist/package-surface/index.js", "default": "./dist/package-surface/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": { "react": ">=19.0.0", "react-dom": ">=19.0.0" },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^6.0.2"
  }
}
