#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

spec="$root/.coding-tooling.source-lock.json"
config="$root/.cargo/config.toml"
state_dir="$root/.cargo/source-lock-state"
snapshot="$state_dir/registry-Cargo.lock"
lockfile="$root/Cargo.lock"
managed_header="# Generated by coding-tooling source-deps. Do not edit."

managed_source_active() {
  [[ -f "$config" ]] || return 1
  [[ "$(head -n 1 "$config")" == "$managed_header" ]]
}

expected_hash() {
  python3 - "$spec" <<'PY'
import json
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
if not path.is_file():
    raise SystemExit(f"missing source-lock specification: {path}")
data = json.loads(path.read_text())
if data.get("schemaVersion") != 1:
    raise SystemExit(f"unsupported source-lock schema: {data.get('schemaVersion')}")
value = data.get("cargoLockSha256", "")
if not re.fullmatch(r"[0-9a-f]{64}", value):
    raise SystemExit("source-lock cargoLockSha256 must be a lowercase SHA-256 digest")
print(value)
PY
}

hash_lock() {
  python3 - "$lockfile" <<'PY'
import hashlib
import sys
from pathlib import Path

path = Path(sys.argv[1])
if not path.is_file():
    raise SystemExit(f"missing Cargo lockfile: {path}")
print(hashlib.sha256(path.read_bytes()).hexdigest())
PY
}

restore_snapshot() {
  if [[ -f "$snapshot" ]]; then
    cp "$snapshot" "$lockfile"
    rm -rf "$state_dir"
  fi
}

prepare() {
  if ! managed_source_active; then
    return 0
  fi

  local expected actual
  expected="$(expected_hash)"

  if [[ -f "$snapshot" ]]; then
    actual="$(hash_lock)"
    if [[ "$actual" != "$expected" ]]; then
      printf 'prepared source lock drifted: expected %s, got %s\n' "$expected" "$actual" >&2
      return 1
    fi
    return 0
  fi

  [[ -f "$lockfile" ]] || {
    printf 'missing registry Cargo.lock: %s\n' "$lockfile" >&2
    return 1
  }

  mkdir -p "$state_dir"
  cp "$lockfile" "$snapshot"

  if ! cargo metadata --format-version 1 >/dev/null; then
    restore_snapshot
    printf '%s\n' 'failed to materialize the exact source-mode Cargo resolution' >&2
    return 1
  fi

  actual="$(hash_lock)"
  if [[ "$actual" != "$expected" ]]; then
    restore_snapshot
    printf 'source-mode Cargo.lock drifted: expected %s, got %s\n' "$expected" "$actual" >&2
    printf '%s\n' 'Review the source dependency graph, then deliberately update .coding-tooling.source-lock.json if the new resolution is intended.' >&2
    return 1
  fi

  printf 'source lock: verified %s\n' "${actual:0:12}"
}

run_scoped() {
  if [[ "${1:-}" == "--" ]]; then
    shift
  fi
  if (( $# == 0 )); then
    printf 'usage: %s run -- <command> [args...]\n' "$0" >&2
    return 2
  fi

  local had_snapshot=false owns_snapshot=false
  if [[ -f "$snapshot" ]]; then
    had_snapshot=true
  fi

  prepare

  if [[ "$had_snapshot" != "true" && -f "$snapshot" ]]; then
    owns_snapshot=true
    trap restore_snapshot EXIT
  fi

  AUDIO_ANALYSIS_SOURCE_LOCK_SCOPE=1 "$@"

  if [[ "$owns_snapshot" == "true" ]]; then
    restore_snapshot
    trap - EXIT
  fi
}

case "${1:-}" in
  prepare)
    prepare
    ;;
  restore)
    restore_snapshot
    ;;
  run)
    shift
    run_scoped "$@"
    ;;
  status)
    if ! managed_source_active; then
      printf '%s\n' 'source lock: inactive'
    elif [[ -f "$snapshot" ]]; then
      expected="$(expected_hash)"
      actual="$(hash_lock)"
      if [[ "$actual" == "$expected" ]]; then
        printf 'source lock: prepared %s\n' "${actual:0:12}"
      else
        printf 'source lock: drifted expected=%s actual=%s\n' "$expected" "$actual" >&2
        exit 1
      fi
    else
      printf '%s\n' 'source lock: active, not prepared'
    fi
    ;;
  *)
    printf 'usage: %s {prepare|restore|status|run -- <command> [args...]}\n' "$0" >&2
    exit 2
    ;;
esac
